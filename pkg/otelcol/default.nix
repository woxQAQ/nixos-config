{
  lib,
  buildGoModule,
}:
buildGoModule (finalAttrs: {
  pname = "otelcol";
  version = "0.155.0";

  # Generated by the OpenTelemetry Collector Builder from ../manifest.yaml.
  # ocb resolves modules over the network, which the sandbox forbids, so we
  # commit the generated sources and regenerate them on demand:
  #
  #   nix shell nixpkgs#opentelemetry-collector-builder nixpkgs#go
  #   ocb --config manifest.yaml --skip-compilation
  src = ./generated;

  vendorHash = "sha256-vfqxj7SM+rAEb1gELBGOalDw9OWTAxahYwbej3TmkMk=";

  env.CGO_ENABLED = 0;

  ldflags = [
    "-s"
    "-w"
  ];

  # ocb stamps an empty version into the generated BuildInfo; inject ours.
  postPatch = ''
    substituteInPlace main.go \
      --replace-fail 'Version:     "",' 'Version:     "${finalAttrs.version}",'
  '';

  # The generated module is named .../cmd/builder, so the main package at
  # the repository root installs as "builder".
  postInstall = ''
    mv $out/bin/builder $out/bin/otelcol
  '';

  meta = {
    description = "Minimal OpenTelemetry Collector: OTLP in, OTLP/HTTP out";
    homepage = "https://opentelemetry.io/docs/collector/";
    license = lib.licenses.asl20;
    mainProgram = "otelcol";
    platforms = lib.platforms.linux;
  };
})
