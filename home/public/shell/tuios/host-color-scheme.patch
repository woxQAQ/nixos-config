+// schemeBackground follows the host appearance even when a guest sets OSC 11.
+// Using the guest background here would prevent applications such as Helix
+// from switching away from their current theme.
+func (e *Emulator) schemeBackground() color.Color {
+	if e.reportBg != nil {
+		return e.reportBg
+	}
+	if e.defaultBg != nil {
+		return e.defaultBg
+	}
+	return color.Black
+}
+
